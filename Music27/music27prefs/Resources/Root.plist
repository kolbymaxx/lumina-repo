	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Music27</string>
			<key>footerText</key>
			<string>1.1.41: tapping the mini pill should now open the full player, with Music’s own animation and lyrics screen. Four builds tried to press a button that expands the mini player; no such button exists. Music’s real mini player has been sitting under the glass pill the whole time — hidden, but still tappable — so the pill now declines touches on its artwork and titles and lets the real one handle them. Play/pause and skip stay ours.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.music27.tweak</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enable Music27</string>
			<key>PostNotification</key>
			<string>com.music27.tweak/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Features</string>
			<key>footerText</key>
			<string>Turning Enable Music27 OFF removes the dock and other chrome immediately. Dock never mutates safe-area insets, never hides Library/MiniPlayer hosts, and never adds subviews to Music's key window.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
