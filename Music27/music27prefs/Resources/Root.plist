<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Music27</string>
			<key>footerText</key>
			<string>1.1.39: tapping the mini pill no longer plays or pauses. Two builds fired two different wrong buttons — shuffle, then play/pause — because the mini player has no button that opens the full player at all. It now does nothing rather than acting on something you did not ask for, and records what the mini player is really made of so the next build can open it properly. The album download button mirrors Music’s own control by rendering it, so the stop ring during a download shows through.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.music27.tweak</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enable Music27</string>
			<key>PostNotification</key>
			<string>com.music27.tweak/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Features</string>
			<key>footerText</key>
			<string>Turning Enable Music27 OFF removes the dock and other chrome immediately. Dock never mutates safe-area insets, never hides Library/MiniPlayer hosts, and never adds subviews to Music's key window.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
