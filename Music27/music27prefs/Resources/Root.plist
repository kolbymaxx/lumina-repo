			<string>clearPins</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Music27 1.1.48 — collapsed row centred and slimmer; house affordance. Verified on iOS 17.3; 16.7 untested.</string>
