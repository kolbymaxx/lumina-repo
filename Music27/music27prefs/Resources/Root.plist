<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Music27</string>
			<key>footerText</key>
			<string>1.1.22: White-screen fix. The overlay window sits at Normal+2 again (the 1.1.12 level); StatusBar level is what blanked Music, not the cover plate. Your Floating Glass Dock setting is kept as-is; force-quit Music after changing it.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.music27.tweak</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enable Music27</string>
			<key>PostNotification</key>
			<string>com.music27.tweak/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Features</string>
			<key>footerText</key>
			<string>Turning Enable Music27 OFF removes the dock and other chrome immediately. Dock never mutates safe-area insets, never hides Library/MiniPlayer hosts, and never adds subviews to Music's key window.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.music27.tweak</string>
			<key>key</key>
			<string>glassTabBar</string>
			<key>label</key>
			<string>Floating Glass Dock</string>
			<key>PostNotification</key>
			<string>com.music27.tweak/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.music27.tweak</string>
			<key>key</key>
			<string>colorTheme</string>
			<key>label</key>
			<string>Artwork Color Theme</string>
			<key>PostNotification</key>
			<string>com.music27.tweak/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.music27.tweak</string>
			<key>key</key>
			<string>libraryPins</string>
			<key>label</key>
			<string>Library Pins</string>
			<key>PostNotification</key>
			<string>com.music27.tweak/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Relaunch Music after changing toggles if a surface does not update.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Clear All Pins</string>
			<key>action</key>
			<string>clearPins</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Music27 1.1.22 — Normal+2 passthrough dock (no cover plate). Verify on iOS 17.3 before APT.</string>
		</dict>
	</array>
	<key>title</key>
	<string>Music27</string>
</dict>
</plist>
