			<string>Relaunch Music after changing toggles if a surface does not update.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Clear All Pins</string>
			<key>action</key>
			<string>clearPins</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Music27 1.1.40 — no stock-button flash; mini-pill and player diagnostics. Verify on iOS 17.3 before APT.</string>
		</dict>
