<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Music27</string>
			<key>footerText</key>
			<string>1.1.18: Solid overlay cover + StatusBar-level dual glass pills (safeBottom+12). Does not fade Music views. Confirm footer says 1.1.18 after install, then force-quit Music.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.music27.tweak</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enable Music27</string>
			<key>PostNotification</key>
			<string>com.music27.tweak/ReloadPrefs</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Features</string>
			<key>footerText</key>
			<string>Turning Enable Music27 OFF removes the dock and other chrome immediately. Dock never mutates safe-area insets, never hides Library/MiniPlayer hosts, and never adds subviews to Music's key window.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.music27.tweak</string>
			<key>key</key>
			<string>glassTabBar</string>
